    <pathAssistantSteps>
        <fieldNames>LT_Tracking_Code__c</fieldNames>
        <fieldNames>LT_SLA_Deadline__c</fieldNames>
        <info>&lt;p&gt;Etiqueta gerada pelo embarcador. Confirme codigo de rastreio, destino e prazo de entrega (SLA).&lt;/p&gt;</info>
        <picklistValueName>Etiqueta Gerada</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>LT_Collected_Date__c</fieldNames>
        <info>&lt;p&gt;Motorista First Mile coletou a remessa no Seller ou no Ponto de Coleta (DropOff).&lt;/p&gt;</info>
        <picklistValueName>Coletado</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>LT_Destination_CD__c</fieldNames>
        <info>&lt;p&gt;Remessa recebida e triada no Centro de Distribuicao (SC) responsavel pelo destino.&lt;/p&gt;</info>
        <picklistValueName>Em Triagem no SC</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;Remessa em transferencia do SC para a Base de Entrega.&lt;/p&gt;</info>
        <picklistValueName>Em Transferencia</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>LT_Delivery_Base__c</fieldNames>
        <info>&lt;p&gt;Remessa recebida na Base de Entrega da ultima milha.&lt;/p&gt;</info>
        <picklistValueName>Recebido na Base</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;Triagem na base: remessa alocada na gaiola da rota correspondente.&lt;/p&gt;</info>
