    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>LT_Last_Mile_Driver__c</fieldNames>
        <info>&lt;p&gt;Remessa bipada para o motorista Last Mile. Rota em execucao.&lt;/p&gt;</info>
        <picklistValueName>Em Rota de Entrega</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>LT_Delivered_Date__c</fieldNames>
        <info>&lt;p&gt;Remessa entregue ao destinatario. Registre data/hora da entrega.&lt;/p&gt;</info>
        <picklistValueName>Entregue</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <info>&lt;p&gt;Tentativa de entrega sem sucesso (ausente, endereco nao localizado, recusa). Nova tentativa sera agendada.&lt;/p&gt;</info>
