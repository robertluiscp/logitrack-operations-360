<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Gross_Amount__c</fullName>
    <description>Total de Pacotes x Valor por Pacote.</description>
    <label>Valor Bruto</label>
    <formula>BLANKVALUE(LT_Total_Packages__c, 0) * BLANKVALUE(LT_Rate_Per_Package__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>16</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
