<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Manifest_Rate_Positive</fullName>
    <active>true</active>
    <description>O valor por pacote deve ser maior que zero.</description>
    <errorConditionFormula>LT_Rate_Per_Package__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>LT_Rate_Per_Package__c</errorDisplayField>
    <errorMessage>Informe um Valor por Pacote maior que zero.</errorMessage>
</ValidationRule>
