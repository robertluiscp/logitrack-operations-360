<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Counts_As_Billed__c</fullName>
    <description>Verdadeiro quando o faturamento ja foi faturado ou pago (entra nos totais consolidados da conta).</description>
    <formula>OR(ISPICKVAL(LT_Billing_Status__c, &quot;Faturado&quot;), ISPICKVAL(LT_Billing_Status__c, &quot;Pago&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Conta como Faturado</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
