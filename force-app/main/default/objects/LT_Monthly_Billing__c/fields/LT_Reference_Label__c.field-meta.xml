<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Reference_Label__c</fullName>
    <description>Rotulo do mes de competencia no formato MM/AAAA.</description>
