<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Billing_Is_Open__c</fullName>
    <description>Verdadeiro enquanto o faturamento do mes ainda esta em apuracao ou fechado (nao faturado).</description>
    <formula>OR(ISPICKVAL(LT_Billing_Status__c, &quot;Em Apuracao&quot;), ISPICKVAL(LT_Billing_Status__c, &quot;Fechado&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Faturamento em Aberto</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
