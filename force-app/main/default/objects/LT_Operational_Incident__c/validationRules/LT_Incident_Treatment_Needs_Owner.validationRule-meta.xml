<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Incident_Treatment_Needs_Owner</fullName>
    <active>true</active>
    <description>Ocorrencia Em Tratamento exige responsavel.</description>
    <errorConditionFormula>AND(ISPICKVAL(LT_Status__c, "Em Tratamento"), ISBLANK(LT_Assigned_To__c))</errorConditionFormula>
    <errorDisplayField>LT_Assigned_To__c</errorDisplayField>
    <errorMessage>Atribua um responsavel antes de mover para Em Tratamento.</errorMessage>
</ValidationRule>
