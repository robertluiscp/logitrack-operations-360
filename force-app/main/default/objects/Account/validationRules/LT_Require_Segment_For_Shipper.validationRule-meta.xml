<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Require_Segment_For_Shipper</fullName>
    <active>true</active>
    <description>Exige o Segmento do Embarcador nas contas do Record Type Embarcador.</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = "LT_Shipper",
    ISBLANK(TEXT(LT_Shipper_Segment__c))
)</errorConditionFormula>
    <errorDisplayField>LT_Shipper_Segment__c</errorDisplayField>
    <errorMessage>Informe o Segmento do Embarcador.</errorMessage>
</ValidationRule>
