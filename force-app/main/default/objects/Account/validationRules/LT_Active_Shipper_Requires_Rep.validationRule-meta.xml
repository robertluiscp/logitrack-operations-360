<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Active_Shipper_Requires_Rep</fullName>
    <active>true</active>
    <description>Embarcador Ativo precisa ter um Executivo Comercial responsável.</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = "LT_Shipper",
    ISPICKVAL(LT_Shipper_Status__c, "Ativo"),
    ISBLANK(LT_Commercial_Rep__c)
)</errorConditionFormula>
    <errorDisplayField>LT_Commercial_Rep__c</errorDisplayField>
    <errorMessage>Defina o Executivo Comercial responsável antes de ativar o embarcador.</errorMessage>
</ValidationRule>
