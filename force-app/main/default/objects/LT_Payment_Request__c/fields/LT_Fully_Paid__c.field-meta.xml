<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Fully_Paid__c</fullName>
    <description>Verdadeiro quando o valor pago cobre o valor solicitado.</description>
    <label>Quitada</label>
    <formula>AND(BLANKVALUE(LT_Amount__c, 0) &gt; 0, BLANKVALUE(LT_Amount_Paid__c, 0) &gt;= LT_Amount__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Checkbox</type>
</CustomField>
