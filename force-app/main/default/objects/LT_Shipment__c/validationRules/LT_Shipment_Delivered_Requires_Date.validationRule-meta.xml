<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Shipment_Delivered_Requires_Date</fullName>
    <active>true</active>
    <description>Remessa Entregue precisa da data da entrega.</description>
    <errorConditionFormula>AND(ISPICKVAL(LT_Status__c, "Entregue"), ISBLANK(LT_Delivered_Date__c))</errorConditionFormula>
    <errorDisplayField>LT_Delivered_Date__c</errorDisplayField>
    <errorMessage>Informe a Data da Entrega ao marcar a remessa como Entregue.</errorMessage>
</ValidationRule>
