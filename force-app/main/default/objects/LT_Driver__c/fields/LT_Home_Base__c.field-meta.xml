    <required>false</required>
    <trackHistory>true</trackHistory>
    <type>Lookup</type>
    <lookupFilter>
        <active>true</active>
        <errorMessage>Vincule o motorista a uma Base de Entrega ou Centro de Distribuicao ativo.</errorMessage>
        <filterItems>
            <field>LT_Logistics_Unit__c.Unit_Status__c</field>
