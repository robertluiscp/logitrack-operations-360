<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Route_MR_Requires_Destination</fullName>
    <active>true</active>
    <description>Mini Transferencia exige unidade de destino.</description>
    <errorConditionFormula>AND(ISPICKVAL(LT_Route_Type__c, "Mini Transferencia"), ISBLANK(LT_Destination_Unit__c))</errorConditionFormula>
    <errorDisplayField>LT_Destination_Unit__c</errorDisplayField>
    <errorMessage>Informe a Unidade de Destino da mini transferencia.</errorMessage>
</ValidationRule>
