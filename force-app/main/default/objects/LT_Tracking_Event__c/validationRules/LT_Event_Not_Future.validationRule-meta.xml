<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Event_Not_Future</fullName>
    <active>true</active>
    <description>O evento nao pode ter data futura.</description>
    <errorConditionFormula>LT_Event_DateTime__c &gt; NOW() + 0.0417</errorConditionFormula>
    <errorDisplayField>LT_Event_DateTime__c</errorDisplayField>
    <errorMessage>A Data/Hora do Evento nao pode estar no futuro.</errorMessage>
</ValidationRule>
