<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Pickup_Scheduled_Requires_Data</fullName>
    <active>true</active>
    <description>Coleta Agendada exige motorista e data.</description>
    <errorConditionFormula>AND(ISPICKVAL(LT_Status__c, "Agendada"), OR(ISBLANK(LT_First_Mile_Driver__c), ISBLANK(LT_Scheduled_Date__c)))</errorConditionFormula>
    <errorDisplayField>LT_First_Mile_Driver__c</errorDisplayField>
    <errorMessage>Informe o Motorista First Mile e a Data Agendada.</errorMessage>
</ValidationRule>
