<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Fill_Rate__c</fullName>
    <description>Percentual coletado em relacao ao estimado.</description>
    <label>Aproveitamento</label>
    <formula>IF(OR(ISBLANK(LT_Estimated_Packages__c), LT_Estimated_Packages__c = 0), 0, LT_Collected_Packages__c / LT_Estimated_Packages__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>5</precision>
    <scale>2</scale>
    <type>Percent</type>
</CustomField>
