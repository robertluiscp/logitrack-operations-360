<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LT_Estimated_Monthly_Revenue__c</fullName>
    <description>Receita mensal estimada: volume mensal estimado x preco por pacote proposto.</description>
    <formula>BLANKVALUE(LT_Estimated_Monthly_Volume__c, 0) * BLANKVALUE(LT_Proposed_Price_Per_Package__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Receita Mensal Estimada</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
