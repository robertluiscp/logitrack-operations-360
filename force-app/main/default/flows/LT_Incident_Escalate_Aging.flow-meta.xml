<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Fluxo agendado diario: ocorrencias abertas ha mais de 10 dias sao escaladas (prioridade Critica, status Escalada) e viram candidatas a extravio.</description>
    <environments>Default</environments>
    <interviewLabel>OC - Escalonar Ocorrencias Antigas {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OC - Escalonar Ocorrencias Antigas</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Escalar_Ocorrencia</name>
        <label>Escalar Ocorrencia</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <inputAssignments>
            <field>LT_Status__c</field>
            <value><stringValue>Escalada</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>LT_Priority__c</field>
            <value><stringValue>Critica</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>LT_Escalated__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>LT_Escalation_Date__c</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Escalar_Ocorrencia</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LT_Is_Open__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <filters>
            <field>LT_Days_Open__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value><numberValue>10.0</numberValue></value>
        </filters>
        <filters>
            <field>LT_Escalated__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>LT_Operational_Incident__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-08</startDate>
            <startTime>04:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
