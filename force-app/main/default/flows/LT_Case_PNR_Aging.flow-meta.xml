<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Fluxo agendado diario: chamados de Assinado nao Recebido encaminhados ao motorista que passaram do prazo sem resolucao viram PNR e sao escalados.</description>
    <environments>Default</environments>
    <interviewLabel>SAC - Detectar PNR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SAC - Detectar PNR</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>fVirouPNR</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  {!$Record.RecordType.DeveloperName} = "LT_Assinado_Nao_Recebido",
  NOT(ISBLANK({!$Record.LT_Driver_Response_Deadline__c})),
  {!$Record.LT_Driver_Response_Deadline__c} &lt; NOW()
)</expression>
    </formulas>
    <decisions>
        <name>Deve_Virar_PNR</name>
        <label>Deve virar PNR?</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <defaultConnectorLabel>Nao</defaultConnectorLabel>
        <rules>
            <name>rSim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fVirouPNR</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Marcar_PNR</targetReference></connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Marcar_PNR</name>
        <label>Marcar PNR e Escalar</label>
        <locationX>50</locationX>
        <locationY>290</locationY>
        <inputAssignments>
            <field>LT_PNR_Flag__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Escalated</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Deve_Virar_PNR</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>LT_PNR_Flag__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Case</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-08</startDate>
            <startTime>03:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
