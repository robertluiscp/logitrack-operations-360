<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Antes do salvamento, quando a solicitacao e criada sem "Solicitado Por", preenche o campo com o usuario atual.</description>
    <environments>Default</environments>
    <interviewLabel>FIN - Solicitado Por {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FIN - Definir Solicitado Por</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Solicitado_Por_Vazio</name>
        <label>Solicitado Por esta vazio?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Ja preenchido</defaultConnectorLabel>
        <rules>
            <name>rVazio</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LT_Requested_By__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Definir_Solicitante</targetReference></connector>
            <label>Vazio</label>
        </rules>
    </decisions>
    <assignments>
        <name>Definir_Solicitante</name>
        <label>Definir Solicitante</label>
        <locationX>50</locationX>
        <locationY>254</locationY>
        <assignmentItems>
            <assignToReference>$Record.LT_Requested_By__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$User.Id</elementReference></value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Solicitado_Por_Vazio</targetReference></connector>
        <object>LT_Payment_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
